    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.choices[0].message.content;\n\nconst match = raw.match(/\\[[\\s\\S]*\\]/);\nif (!match) {\n  throw new Error(`No JSON array found in LLM response: ${raw}`);\n}\n\nlet results;\ntry {\n  results = JSON.parse(match[0]);\n} catch (e) {\n  throw new Error(`Failed to parse extracted JSON: ${match[0]}`);\n}\n\nfor (const r of results) {\n  console.log(`id: ${r.id}, category: ${r.category}`);\n}\n\nreturn results.map(r => ({\n  json: {\n    id: r.id,\n    skill_category: r.category\n  }\n}));"
      },
